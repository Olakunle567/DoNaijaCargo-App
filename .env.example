# Firebase Web SDK config (Firebase console > Project settings > General > Your apps > SDK setup and config).
# Read by app.config.ts at build/start time and exposed to the app via Constants.expoConfig.extra.firebase.
# These are not secret (they identify the project, not authorize access) but still shouldn't be hardcoded.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
# Optional: only needed if Analytics is enabled for the Firebase web app.
FIREBASE_MEASUREMENT_ID=

# Optional, dev only: host the app should use to reach the local Firebase emulators
# (src/lib/firebase.ts, active when __DEV__). Defaults to "localhost", which only
# works in a web browser or simulator/emulator running on the same machine as the
# Firebase emulators. On a physical device over Expo Go, set this to your
# development machine's LAN IP instead, e.g. EXPO_PUBLIC_FIREBASE_EMULATOR_HOST=192.168.1.23
# Must be prefixed EXPO_PUBLIC_ to be readable from app code (see .env for app.config.ts-only vars).
EXPO_PUBLIC_FIREBASE_EMULATOR_HOST=localhost

# Feature flag (src/auth/AuthContext.tsx): when unset/false, the Google/Apple
# buttons keep the mocked timer-based sheets (GoogleAuthSheet/AppleAuthSheet)
# and just sign in (or create, on first use) a fixed demo Firebase user. Set
# to "true" once the Google/Apple config below is filled in and you're
# running a rebuilt dev client (native modules — Expo Go won't work).
EXPO_PUBLIC_AUTH_SOCIAL_REAL=false

# Google Sign-In (Google Cloud Console, or Firebase console > Authentication >
# Sign-in method > Google > Web SDK configuration, which provisions the same
# OAuth client). Read by app.config.ts.
#   webClientId: the "Web application" OAuth client ID. Required on every
#     platform — GoogleSignin uses it to request an ID token that Firebase's
#     GoogleAuthProvider can verify (it must match the OAuth client Firebase
#     Auth has on file for this project, i.e. the same Web client ID shown
#     under Firebase's Google provider settings).
#   iosClientId: the "iOS" OAuth client ID. Only needed for iOS builds.
#   iosUrlScheme: the iOS client's reversed ID (Google Cloud Console shows it,
#     or it's the REVERSED_CLIENT_ID in GoogleService-Info.plist, something
#     like com.googleusercontent.apps.XXXXXXXXXX). Baked into the iOS native
#     project by the google-signin config plugin — requires a prebuild/EAS
#     rebuild after changing it, not just a JS reload.
GOOGLE_SIGNIN_WEB_CLIENT_ID=
GOOGLE_SIGNIN_IOS_CLIENT_ID=
GOOGLE_SIGNIN_IOS_URL_SCHEME=

# Apple Sign-In: no env config needed. Requires an Apple Developer account
# with "Sign In with Apple" enabled for the com.donaijacargo.app bundle ID
# (app.json already sets ios.usesAppleSignIn), and it's iOS-only — Apple
# doesn't offer a native sign-in surface on Android, so the Apple button only
# does the real thing on iOS (see Platform.OS checks in SignInScreen /
# SignUpScreen).
